{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verdict",
  "description": "Trust verdict emitted by Participant 2's reasoning engine",
  "type": "object",
  "required": ["verdict", "confidence", "evidence_coverage"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["AUTHENTIC", "MANIPULATED", "COORDINATED_SYNTHETIC", "INSUFFICIENT_EVIDENCE"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Fraction of artifacts that contributed usable evidence"
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Human-readable explanation strings"
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_a": { "type": "string" },
          "artifact_b": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_a": { "type": "string" },
          "artifact_b": { "type": "string" },
          "relation": { "type": "string" },
          "confidence": { "type": "number" }
        }
      }
    },
    "llm_explanation": {
      "type": "string",
      "description": "Free-text explanation from LLM reasoning step"
    }
  }
}
